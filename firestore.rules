rules_version = '2';

// ------------------------------------------------------------------
// Firestore 보안 규칙 — 한 Firebase 프로젝트를 두 수업이 함께 씁니다.
//
//   · 파이썬 첫걸음 채점기  (roster / rosterPins / submissions / classroom)
//   · 디지털 시민 신호등    (dc_classes / dc_groups / dc_classroom)
//
// ⚠️ Firebase 콘솔의 규칙은 프로젝트 전체에 하나뿐입니다. 이 파일을 통째로
//    복사해 Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 "게시"를
//    누르세요. 앞부분의 파이썬 첫걸음 규칙이 그대로 들어 있어야 그 수업도
//    계속 동작합니다.
//
// 요약
//  - 학생은 익명으로 로그인한다. 이름·번호는 Firebase 계정이 아니다.
//  - 학생은 자기 모둠 점수만 쓰고 고칠 수 있다. 남의 모둠은 건드리지 못한다.
//  - 모둠 순위 전체를 읽는 것은 선생님뿐이다.
//  - 함께 보기에서 오가는 것은 선생님이 지정한 미션 이름 하나뿐이다.
// ------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // 선생님 계정 — 아이디 "선생님"으로 로그인하면 이 주소가 된다.
    function isTeacher() {
      return request.auth != null
          && request.auth.token.email == 'teacher@python-first-steps.local';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ════════════════ 파이썬 첫걸음 채점기 ════════════════

    // 학생 명단 — 이름과 번호의 해시만 들어 있다.
    match /roster/{studentId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // 4자리 번호 원본 — 학생은 절대 읽을 수 없다.
    match /rosterPins/{studentId} {
      allow read, write: if isTeacher();
    }

    // 제출 기록 — 학생은 새로 쓰기만, 선생님은 전부 읽기.
    match /submissions/{docId} {
      allow read, update, delete: if isTeacher();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'studentId', 'name', 'score', 'wrong', 'lines', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() <= 60
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.wrong is number
        && request.resource.data.wrong >= 0
        && request.resource.data.wrong <= 3
        && request.resource.data.lines is list
        && request.resource.data.lines.size() == 3;
    }

    // 함께 보기 — 선생님이 지금 보고 있는 탭 이름 하나.
    match /classroom/{docId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ════════════════ 디지털 시민 신호등 ════════════════

    // 선생님이 연 수업. 학생은 코드가 열려 있는지 확인만 한다.
    match /dc_classes/{code} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // 모둠별 점수.
    //  - 선생님은 모두 읽고 지울 수 있다 (수업이 끝난 뒤 정리용).
    //  - 학생은 자기가 만든 모둠 문서만 쓰고 고칠 수 있다.
    //    uid 를 함께 저장해 두고, 고칠 때 그 uid 가 자기 것인지 확인한다.
    //  - 학생은 남의 모둠 점수를 읽지 못한다. 순위는 선생님 화면에서만 본다.
    match /dc_groups/{groupId} {
      allow read, delete: if isTeacher();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 6
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 38;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == resource.data.code
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 38;
    }

    // 함께 보기 — 선생님이 지정한 미션 하나. 수업 코드마다 문서 하나.
    // 점수는 여기에 들어가지 않으므로 학생이 읽어도 안전하다.
    match /dc_classroom/{code} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // 그 밖의 모든 경로는 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
