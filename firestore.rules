rules_version = '2';

// ------------------------------------------------------------------
// 디지털 시민 신호등 — Firestore 보안 규칙
//
// 이 프로젝트는 이 수업 하나만 씁니다. (파이썬 첫걸음 채점기는 별도의
// Firebase 프로젝트를 쓰므로 여기 규칙과 서로 영향을 주지 않습니다.)
//
// 올리는 방법 — 아래 명령 한 줄이면 됩니다.
//     firebase deploy --only firestore:rules
// 콘솔에서 직접 붙여넣으려면 Firestore Database > 규칙 탭에 통째로 넣고
// "게시"를 누르세요.
//
// 요약
//  - 학생은 익명으로 들어온다. 이름·모둠 이름은 계정이 아니라 화면에 적는 값이다.
//  - 학생은 자기 모둠 점수만 쓰고 고칠 수 있다. 남의 모둠은 건드리지 못한다.
//  - 모둠 순위 전체를 읽는 것은 선생님뿐이다.
//  - 함께 보기에서 오가는 것은 선생님이 지정한 미션 이름 하나뿐이다.
// ------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // 선생님 계정 — 로그인 화면에 아이디 "선생님"을 적으면 이 주소가 된다.
    function isTeacher() {
      return request.auth != null
          && request.auth.token.email == 'teacher@digital.local';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // 선생님이 연 수업. 학생은 코드가 열려 있는지 확인만 한다.
    match /dc_classes/{code} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // 모둠별 점수.
    //  - 선생님은 모두 읽고 지울 수 있다 (수업이 끝난 뒤 정리용).
    //  - 학생은 자기가 만든 모둠 문서만 쓰고 고칠 수 있다.
    //    uid 를 함께 저장해 두고, 고칠 때 그 uid 가 자기 것인지 확인한다.
    //  - 학생은 남의 모둠 점수를 읽지 못한다. 순위는 선생님 화면에서만 본다.
    match /dc_groups/{groupId} {
      allow read, delete: if isTeacher();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 6
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 48;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == resource.data.code
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 48;
    }

    // 함께 보기 — 선생님이 지정한 미션 하나. 수업 코드마다 문서 하나.
    // 점수는 여기에 들어가지 않으므로 학생이 읽어도 안전하다.
    match /dc_classroom/{code} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // 그 밖의 모든 경로는 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
